# Supabase (browser-safe publishable values only)
VITE_SUPABASE_URL=https://mfjqjhvhqzcnmrvycdxc.supabase.co
# Paste anon/public key from Supabase → Project Settings → API
VITE_SUPABASE_ANON_KEY=PASTE_YOUR_ANON_KEY_HERE

# Square Web Payments + POS (browser-safe application id + location only)
VITE_SQUARE_APPLICATION_ID=sandbox-sq0idb-xxxxxxxx
VITE_SQUARE_LOCATION_ID=your-location-id
VITE_SQUARE_ENVIRONMENT=sandbox

# App URL used for auth redirects (SSR/build; browser uses window.location.origin)
VITE_APP_URL=http://localhost:8080

# Edge function CORS (comma-separated production origins; leave empty for *)
# ALLOWED_ORIGINS=https://your-domain.com

# --- Edge Function secrets (set with `supabase secrets set`, NEVER prefix with VITE_) ---
# SQUARE_ACCESS_TOKEN=sandbox-sq0atb-xxxxxxxx
# SQUARE_ENVIRONMENT=sandbox
# SQUARE_LOCATION_ID=your-location-id
# SQUARE_WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key
# SQUARE_WEBHOOK_NOTIFICATION_URL=https://<project-ref>.supabase.co/functions/v1/square-webhook
